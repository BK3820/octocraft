{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "imagePullSecrets", "replicaCount", "app", "secrets", "persistence", "keyVault", "workloadIdentity", "resources"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {"name": {"type": "string", "minLength": 1}}
      }
    },
    "replicaCount": {"type": "integer", "enum": [1]},
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseURL", "allowSimulate"],
      "properties": {
        "baseURL": {"type": "string", "pattern": "^$|^https?://[^\\s]+$"},
        "allowSimulate": {"type": "boolean"}
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "ingestTokenKey", "githubTokenKey"],
      "properties": {
        "existingSecret": {"type": "string", "minLength": 1},
        "ingestTokenKey": {"type": "string", "minLength": 1},
        "githubTokenKey": {"type": "string"}
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingClaim", "size", "storageClass"],
      "properties": {
        "existingClaim": {"type": "string"},
        "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"},
        "storageClass": {"type": "string", "minLength": 1}
      }
    },
    "keyVault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "pattern": "^$|^https://[a-zA-Z0-9-]+\\.vault\\.azure\\.net/?$"}
      }
    },
    "workloadIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientId", "tenantId"],
      "properties": {
        "clientId": {"type": "string", "pattern": "^$|^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"},
        "tenantId": {"type": "string", "pattern": "^$|^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {"cpu": {"type": "string", "minLength": 1}, "memory": {"type": "string", "minLength": 1}}
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {"cpu": {"type": "string", "minLength": 1}, "memory": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
